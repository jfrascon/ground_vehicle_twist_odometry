<?xml version="1.0"?>

<!-- Helper launch to run bringup in simulation mode -->
<launch>

  <!-- ************************************************************************ -->
  <!-- GROUND VEHICLE TWIST ODOMETRY -->
  <!-- ************************************************************************ -->

  <arg name="config_file" default="$(find-pkg-share eut_ground_vehicle_twist_odometry)/config/params/example_ground_vehicle_twist_odometry.yaml"/>

  <node pkg="eut_ground_vehicle_twist_odometry" exec="ground_vehicle_twist_odometry_node" name="ground_vehicle_twist_odometry" output="screen">
    <param from="$(var config_file)"/>
  </node>

</launch>